# See README.md for full details on each variable.

PORT=5000
NODE_ENV=production

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=owngains

# openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Comma-separated, exact origins. "*" is NOT a wildcard here and is refused at
# boot. The native app sends no Origin header, so this only affects web clients.
ALLOWED_ORIGINS=http://localhost:3000

# 0 when the port is exposed directly (req.ip is then the unspoofable socket
# address); set to 1 if behind nginx/Caddy/Traefik, or every client shares one
# rate-limit bucket. Must be a non-negative integer — "true" is refused at boot.
TRUST_PROXY_HOPS=0

# Skip the rate limiters for loopback/private-range callers. Only meaningful
# when TRUST_PROXY_HOPS matches your deployment: with a proxy in front and
# TRUST_PROXY_HOPS=0, every request looks local and rate limiting is off for
# everyone. The server warns loudly at boot if you set both that way.
RATE_LIMIT_BYPASS_LOCAL_IPS=false

# Hostname advertised to LAN clients over mDNS and echoed on /healthz.
SERVER_FQDN=

# Per-user progress-photo storage cap in MB (0 disables). Photo bytes are the
# only unbounded growth path here, and a full MySQL data directory fails every
# write on the instance, not just uploads. Must be a number >= 0 or the server
# refuses to boot. 1024 suits a box you share with a few friends; if signup is
# open to strangers, lower it to 100-200.
PHOTO_QUOTA_MB=1024

# Instance-wide progress-photo cap in GB across every user (0 = off). When it
# is reached uploads get 507 and an error is logged. Set it below the free
# space of the MySQL data directory on any box with open signup.
PHOTO_TOTAL_QUOTA_GB=0


# Features kept on-device instead of stored here (saves disk): tracking,supplements
LOCAL_ONLY_FEATURES=

# ─── Capacity & hardening (defaults suit a small self-hosted box) ────────────
# DB connection pool size and how many queries may wait for a connection.
# Past the queue, and on DB timeouts, requests get 503 + Retry-After.
DB_POOL_SIZE=8
DB_QUEUE_LIMIT=200
# Server-side per-statement timeout (0 disables).
DB_QUERY_TIMEOUT_MS=30000
# TLS to MySQL. DB_SSL_CA (path to a PEM file) implies DB_SSL=true.
DB_SSL=false
DB_SSL_CA=

# Per-IP, per 15 min: failed signin/password-change/account-delete attempts,
# and signups. Per IP per minute: everything else under /api.
AUTH_RATE_LIMIT=20
SIGNUP_RATE_LIMIT=20
API_RATE_LIMIT=200
# Per user, per 15 min: request bodies over 50kb (program upload/sharing).
LARGE_BODY_RATE_LIMIT=20

# LAN discovery over mDNS. Set false on a cloud VM / public host.
MDNS_ENABLED=true

# WebSocket caps: total sockets, sockets per client IP (pending + open),
# and simultaneous devices per user.
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_SOCKETS_PER_USER=5

# Public instances: name the one account that becomes admin on signup. Unset =
# the first-ever user (fine on a private box, a race on a public one).
BOOTSTRAP_ADMIN_USERNAME=

# Page ceiling for GET /api/sessions?includeTimings=true. The app pages with
# nextCursor. Raise it only for app builds that fetch history in one request.
HISTORY_TIMINGS_MAX=100

# Admin-only server metrics: GET /api/admin/metrics (JSON, for the app) and the
# /admin/metrics web dashboard (sign in with an admin account). METRICS_ENABLED
# turns both off; METRICS_PAGE_ENABLED=false keeps the JSON but drops the page.
METRICS_ENABLED=true
METRICS_PAGE_ENABLED=true

# Official server only: the Web OAuth client ID that enables POST /api/auth/google.
# Leave unset on a self-hosted instance.
GOOGLE_WEB_CLIENT_ID=
