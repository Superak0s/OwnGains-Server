# Copy to .env. Empty or commented out = default. README.md has the long version.

# ─── Required ────────────────────────────────────────────────────────────────
DB_USER=
DB_PASSWORD=
# openssl rand -base64 32
JWT_SECRET=
# Web origins allowed to call the API, comma-separated. "*" is refused.
# The app sends no Origin, so this only matters for browsers.
ALLOWED_ORIGINS=http://localhost:3000

# ─── Basics ──────────────────────────────────────────────────────────────────
PORT=5000
# development = full error details in responses
NODE_ENV=production
# debug (every request) | info | warn | error
LOG_LEVEL=info
# Docker sets DB_HOST/DB_PORT itself.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=owngains
JWT_EXPIRES_IN=15m
# Name shown on /healthz and over mDNS. Default: machine hostname.
SERVER_FQDN=
# Advertise on the LAN. false on a cloud VM. Docker forces false.
MDNS_ENABLED=true

# ─── Proxy ───────────────────────────────────────────────────────────────────
# 0 = port exposed directly. 1 = behind nginx/Caddy/Traefik.
# Wrong value = every client shares one rate-limit bucket.
TRUST_PROXY_HOPS=0
# Skip rate limits for LAN/localhost callers. Needs a correct TRUST_PROXY_HOPS,
# or behind a proxy everyone looks local.
RATE_LIMIT_BYPASS_LOCAL_IPS=false

# ─── Features ────────────────────────────────────────────────────────────────
# Kept on the phone, never stored here: tracking,supplements
LOCAL_ONLY_FEATURES=
# Switched off and hidden in the app: messages
DISABLED_FEATURES=
# Admin on signup. Empty = first user (set it on a public box).
BOOTSTRAP_ADMIN_USERNAME=
# Force app update below this version (x.y.z).
MIN_APP_VERSION=
# Block writes until the user accepts. Turn off only for old app builds.
REQUIRE_TERMS_ACCEPTANCE=true
REQUIRE_HEALTH_CONSENT=true

# ─── Storage ─────────────────────────────────────────────────────────────────
# Progress photos. 0 = no cap. Use 100-200 MB per user with open signup.
PHOTO_QUOTA_MB=1024
# Whole-server photo cap. Keep it below the DB disk's free space.
PHOTO_TOTAL_QUOTA_GB=0
# Days to keep user reports. 0 = forever.
REPORT_RETENTION_DAYS=365

# ─── Database tuning ─────────────────────────────────────────────────────────
DB_POOL_SIZE=8
# Queries that may wait for a connection before 503.
DB_QUEUE_LIMIT=200
# 0 = no timeout.
DB_QUERY_TIMEOUT_MS=30000
# TLS to MySQL. Setting DB_SSL_CA (PEM path) turns it on.
DB_SSL=false
DB_SSL_CA=

# ─── Rate limits ─────────────────────────────────────────────────────────────
# Per IP, per 15 min
AUTH_RATE_LIMIT=20
SIGNUP_RATE_LIMIT=20
# Per IP, per minute
API_RATE_LIMIT=200
UPDATES_RATE_LIMIT=600
# Per user, per 15 min
LARGE_BODY_RATE_LIMIT=20
DEMO_FILL_RATE_LIMIT=5
# Password hashes at once (CPU-heavy).
BCRYPT_MAX_CONCURRENCY=2
# Max sessions per GET /api/sessions?includeTimings=true page.
HISTORY_TIMINGS_MAX=100

# ─── WebSocket ───────────────────────────────────────────────────────────────
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_SOCKETS_PER_USER=5

# ─── Admin metrics ───────────────────────────────────────────────────────────
# /api/admin/metrics (JSON) and /admin/metrics (web page).
METRICS_ENABLED=true
METRICS_PAGE_ENABLED=true

# ─── Telegram alerts ─────────────────────────────────────────────────────────
# On when both are set. Needs METRICS_ENABLED and a correct TRUST_PROXY_HOPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Refused requests per IP per minute before an alert.
BOT_ALERT_THRESHOLD=60
# 5-minute health limits. 0 = off.
ALERT_P95_MS=500
ALERT_P99_MS=1000
ALERT_ERROR_RATE_PCT=1
# Fewer requests than this = no judgement.
ALERT_MIN_REQUESTS=30

# ─── Backups (npm run owngains backup ...) ───────────────────────────────────
# Default ./backups. Docker uses /backups, so leave it unset there.
#BACKUP_DIR=./backups
# Also how long deleted accounts can come back from a restore.
BACKUP_RETENTION_DAYS=30
# age public key (age1...). Empty = unencrypted backups.
BACKUP_AGE_RECIPIENT=
# Commands to run, e.g. MYSQLDUMP="docker exec -i -e MYSQL_PWD db mysqldump"
#MYSQLDUMP=mysqldump
#MYSQL=mysql
#AGE=age

# ─── Push & updates ──────────────────────────────────────────────────────────
# Firebase service-account JSON or path. Empty = no push, messages off.
FCM_SERVICE_ACCOUNT=
# Folder of signed OTA updates from the app's `npm run publish:ota`.
UPDATES_DIR=

# ─── Official server only (leave empty when self-hosting) ────────────────────
GOOGLE_WEB_CLIENT_ID=
LEGAL_PAGES_ENABLED=false
# Default: the app repo's docs/ on GitHub
#LEGAL_PAGES_URL=

# ─── Marketplace (docker compose --profile marketplace up -d) ────────────────
# Most self-hosters skip this. Apps use the official marketplace.
# openssl rand -hex 32. Changing it resets download counts.
DOWNLOAD_SALT=
# Its own DB user, limited to skin* tables. Set before first `up`, no ' allowed.
MARKETPLACE_DB_USER=marketplace
MARKETPLACE_DB_PASSWORD=
# Server whose accounts can publish. Docker default: the one next to it.
AUTH_SERVER_URL=
# Address used in share links, e.g. https://example.com/marketplace
MARKETPLACE_PUBLIC_URL=
# Shown on share pages for reports. Empty hides it.
MARKETPLACE_REPORT_EMAIL=
MARKETPLACE_PORT=5100
# Same rules as TRUST_PROXY_HOPS. If 1, publish the port as
# 127.0.0.1:5100:5100 or clients can spoof their IP.
MARKETPLACE_TRUST_PROXY_HOPS=0

# ─── Dev only ────────────────────────────────────────────────────────────────
# Tests drop this database. Default: <DB_NAME>_test
TEST_DB_NAME=
SONAR_TOKEN=
