# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment variables
.env

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build
dist/
build/

# SonarQube scanner cache
.scannerwork/

# npm lockfile (this repo standardizes on pnpm)
package-lock.json

coverage/

# Markdown is ignored by default so generated notes (audits, fix lists, plans)
# never get committed. A new doc that belongs in the repo needs a `!` line here.
*.md
!/README.md
!/CHANGELOG.md
!/CLAUDE.md
!/src/migrations/README.md
!/.claude/**/*.md
!/.github/**/*.md

# Database backups (scripts/backup.sh)
backups/

# Local prose linting (not part of the repo)
.vale/
.vale.ini
