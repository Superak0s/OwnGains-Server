{
  "name": "owngains-server",
  "version": "0.5.2",
  "description": "Sync, accounts and social backend for the OwnGains fitness app — central instance or self-hosted",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && bun scripts/copy-assets.mjs",
    "dev": "bun --watch src/server.ts",
    "start": "bun dist/server.js",
    "owngains": "bun src/owngains.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bun scripts/smoke.mjs",
    "sonar:scan": "bash scripts/sonar-scan.sh"
  },
  "keywords": [
    "workout",
    "exercise",
    "fitness",
    "express"
  ],
  "type": "module",
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bonjour-service": "^1.4.4",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "sharp": "^0.35.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.2",
    "supertest": "^7.3.0",
    "tsc-alias": "^1.9.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
